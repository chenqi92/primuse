PRIMUSE_RELAY_LISTEN_ADDR=:8787
PRIMUSE_RELAY_DATA_DIR=/data
PRIMUSE_RELAY_PUBLIC_BASE_URL=https://share.example.com

# Generate independently, keep only in relay.env, and rotate after exposure.
# openssl rand -base64 32
PRIMUSE_RELAY_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# openssl rand -hex 32
PRIMUSE_RELAY_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN

PRIMUSE_RELAY_CHUNK_SIZE=4194304
PRIMUSE_RELAY_MAX_FILE_BYTES=21474836480
PRIMUSE_RELAY_MAX_TTL_SECONDS=2592000
PRIMUSE_RELAY_UPLOAD_TTL_SECONDS=86400
PRIMUSE_RELAY_PUBLIC_REQUESTS_PER_MINUTE=600
PRIMUSE_RELAY_SHORT_CODE_REQUESTS_PER_MINUTE=60
PRIMUSE_RELAY_SHORT_CODE_FAILURES_PER_WINDOW=5
PRIMUSE_RELAY_SHORT_CODE_FAILURE_WINDOW_SECONDS=600
PRIMUSE_RELAY_SHORT_CODE_MAX_TTL_SECONDS=86400
PRIMUSE_RELAY_MAX_PUBLIC_STREAMS=32
PRIMUSE_RELAY_MAX_UPLOADS=4
