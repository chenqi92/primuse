.DS_Store

# Xcode user-specific files
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# Build outputs
build/
build_device/
DerivedData/

# Swift Package Manager
.build/
.swiftpm/

# Local tooling
# scripts/ 下的本地工具默认不入库；架构关卡、钩子和安装器入库（新加的文件不用 -f）
/scripts/*
!/scripts/gate/
!/scripts/git-hooks/
!/scripts/install-git-hooks.sh
.claude/
.idea/
.zed/
.playwright-mcp/
design/
ScraperConfigs/**
Config/Secrets.local.xcconfig
/ShareRelay/relay.env

# Local secret backups / legacy per-developer secret files
Primuse/Services/Scrobble/AppSecrets.local.swift*
*.log

# codex tool env
.codex/
.codex-tmp/

# 已删除的独立 tvOS 预览工程生成过的文件, 旧检出里可能还留着
PrimuseTVPreview.xcodeproj/
PrimuseTV/Info-preview.plist
# 官网内容归属独立仓库 primuse-homepage, 误放于此, 不并入 app 仓库
/web/
music
output
.playwright-cli
Marketing

# Local QA plans, execution evidence, and design notes
/Docs/*
!/Docs/community/
/Docs/community/*
!/Docs/community/wechat-group.jpg
!/Docs/ARCHITECTURE.md
/BAIDU_PAN_FIX/

# App 运行时诊断报告 (MetricKit / 崩溃 JSON)
/logs/

# Python
__pycache__/
*.pyc
.openidea
